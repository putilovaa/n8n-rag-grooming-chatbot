    {
      "parameters": {
        "jsCode": "const grouped = new Map();\n\nfor (const item of $input.all()) {\n  const metadata = item.json.metadata ?? item.json;\n\n  const documentId =\n    metadata.document_id ??\n    metadata.documentId;\n\n  if (!documentId) {\n    continue;\n  }\n\n  if (!grouped.has(documentId)) {\n    grouped.set(documentId, {\n      json: {\n        document_id: documentId,\n\n        document_name:\n          metadata.document_name ??\n          metadata.documentName ??\n          'Unknown document',\n\n        version_id:\n          metadata.version_id,\n\n        source: 'google_drive',\n        namespace: 'Q&A',\n        status: 'active',\n\n        last_synced_at: new Date().toISOString(),\n\n        chunks_count: 0,\n      },\n    });\n  }\n\n  grouped.get(documentId).json.chunks_count += 1;\n}\n\nreturn [...grouped.values()];"
      },
