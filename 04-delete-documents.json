      "parameters": {
        "jsCode": "const registryRows = $input.all();\n\n// Файли, які зараз реально існують у Google Drive\nconst driveFiles = $('Search files and folders').all();\n\n// Збираємо всі Google Drive file IDs\nconst driveIds = new Set(\n  driveFiles\n    .map(item => String(item.json.id || ''))\n    .filter(Boolean)\n);\n\n// З Registry залишаємо тільки ті документи,\n// яких уже НЕМАЄ в Google Drive\nconst deletedDocuments = registryRows.filter(item => {\n  const documentId = String(item.json.document_id || '');\n  return documentId && !driveIds.has(documentId);\n});\n\nreturn deletedDocuments;"
      },
